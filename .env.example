# Phasma AI Environment Variables Example
# Copy this to .env and replace with your actual values

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Alpaca paper trading — REQUIRED for execution.mode=PAPER_ALPACA performance tracking
# Get paper keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Optional aliases also accepted by EnhancedAlpacaPaperTrader:
# ALPACA_KEY=
# ALPACA_SECRET_KEY=

# API Keys (if needed for other integrations)
# NEWS_API_KEY=your_news_api_key_here
# MARKETAUX_API_KEY=your_marketaux_api_key_here
# WEBULL_API_KEY=your_webull_api_key_here

# Web search — company name resolution fallback (utils/web_search_resolver.py)
# Behavior is env-driven (not config.json):
WEB_SEARCH_ENABLED=true
# Provider names: duckduckgo, yahoo_finance, google_finance, brave, google, searxng
# Omit google if skipping Google CSE; include searxng when SEARXNG_URL is set.
WEB_SEARCH_PROVIDERS=duckduckgo,yahoo_finance,google_finance,brave,searxng
WEB_SEARCH_CACHE_TTL_HOURS=6
# ddgs library (duckduckgo provider): avoid backend=auto (tries mojeek, google, etc.)
DDGS_BACKEND=duckduckgo
# DDGS_BACKEND=duckduckgo,bing,brave
# DDGS_TIMEOUT=8
# No keys needed for duckduckgo, yahoo_finance, google_finance, searxng in WEB_SEARCH_PROVIDERS.
# Optional keyed providers improve hit rate when free sources fail:

# Brave Search API (https://api.search.brave.com/app/keys)
BRAVE_SEARCH_API_KEY=          # Free Web Search
BRAVE_AI_API_KEY=              # Free AI — also powers llm_prediction Brave grounding (engines/llm_prediction_engine.py)
BRAVE_AUTOSUGGEST_API_KEY=     # Free Autosuggest
BRAVE_SPELLCHECK_API_KEY=      # Free Spellcheck

# GOOGLE_API_KEY=         # Google Programmable Search (~100 queries/day free)
# GOOGLE_CSE_ID=          # Custom Search Engine ID (cx)

# SearXNG — privacy metasearch, no API key (utils/web_search_resolver.py → searxng provider)
# Base URL only (no /search path). Trailing slash optional; Phasma strips it.
# Pick a public instance from https://searx.space (instances tab) or self-host:
#   https://docs.searxng.org/admin/installation.html
# Public instances can be flaky or rate-limited; self-host for production reliability.
# Examples from searx.space (verify availability before use; do not commit live URLs):
#   https://search.bus-hit.me
#   https://searx.be
#   https://search.mdosch.de
SEARXNG_URL=

# SEC EDGAR company ticker cache (engines/sec_edgar_integration.py)
# SEC requires a descriptive User-Agent: https://www.sec.gov/os/accessing-edgar-data
# SEC_USER_AGENT=YourAppName (you@example.com)
# How often to re-download company_tickers.json (hours). Default 24.
# SEC_CACHE_REFRESH_HOURS=24
# More frequent refresh examples:
# SEC_CACHE_REFRESH_HOURS=10
# SEC_CACHE_REFRESH_HOURS=5
